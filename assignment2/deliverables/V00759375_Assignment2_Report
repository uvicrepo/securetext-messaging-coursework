    def oauth_login(self, conn, redirect_url):
        expected_state = self.oauth_pending_state.pop(conn, None)
        parsed = urllib.parse.urlparse(redirect_url)
        qs = urllib.parse.parse_qs(parsed.query)
        code = qs.get('code', [None])[0]
        returned_state = qs.get('state', [None])[0]

        if not expected_state or returned_state != expected_state:
            return False, "OAuth state mismatch - login aborted", None
        if not code:
            return False, "No authorization code found in that URL", None

        token_resp = requests.post(GITHUB_TOKEN_URL, headers={'Accept': 'application/json'}, data={
            'client_id': GITHUB_CLIENT_ID,
            'client_secret': GITHUB_CLIENT_SECRET,
            'code': code,
            'redirect_uri': GITHUB_REDIRECT_URI
        })
        access_token = token_resp.json().get('access_token')
        if not access_token:
            return False, "GitHub did not return an access token", None

        auth_header = {'Authorization': f'Bearer {access_token}'}
        github_user = requests.get(GITHUB_USER_URL, headers=auth_header).json()
        github_username = github_user.get('login')

        emails = requests.get(GITHUB_EMAILS_URL, headers=auth_header).json()
        primary_email = next((e['email'] for e in emails if e.get('primary')), None)

        matched_username = None
        if primary_email:
            for uname, record in self.users.items():
                if record.get('email') == primary_email:
                    matched_username = uname
                    break

        if matched_username:
            login_username = matched_username
            conflict_note = ""
        else:
            login_username = github_username
            conflict_note = ""
            if login_username in self.users:
                login_username = f"{github_username}_github"
                conflict_note = f" (username '{github_username}' already taken; defaulting to: '{login_username}')"
            if login_username not in self.users:
                self.users[login_username] = {
                    'email': primary_email,
                    'oauth_provider': 'github',
                    'created_at': datetime.now().isoformat()
                }
                self.save_users()

        return True, f"Logged in via GitHub as {login_username}{conflict_note}", login_username

```

#### 2.2.3 Challenges and Solutions
The main design question was where account creation's password hashing was supposed to happen, client side or server side, since the assignment wording used the method name create_account() which exists on both sides. Looking at how authenticate() only exists on the server, and how the stored users.json file is only ever touched by server side code, made it clear that all hashing and salting had to be server side, with the client only ever sending a plaintext password over the (already unencrypted) socket.

While wiring this task in, I hit a bug where account creation appeared to work but then crashed on login, caused by the client hashing the password locally before sending it, so the server ended up hashing an already hashed value with its own separate salt. Fixing that meant having the client send the real password and letting the server handle hashing and salting entirely, consistent with how login already worked.

